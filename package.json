{
  "name": "sumagig",
  "version": "0.1.0",
  "private": true,
  "description": "SumaGig — スマホで完結するマイクロジョブプラットフォーム",
  "workspaces": [
    "apps/mobile",
    "packages/api",
    "packages/shared"
  ],
  "scripts": {
    "setup": "bash scripts/setup.sh",
    "validate:env": "bash scripts/validate-env.sh",
    "db:migrate": "bash scripts/db-migrate.sh",
    "db:migrate:local": "bash scripts/db-migrate.sh --local",
    "dev:api": "cd packages/api && npm run dev",
    "dev:lp": "npx serve . -p 3000",
    "dev:mobile": "cd apps/mobile && npm start",
    "build:api": "cd packages/api && npx tsc --noEmit",
    "build:mobile": "cd apps/mobile && npx tsc --noEmit",
    "typecheck": "npm run build:api && npm run build:mobile",
    "deploy:api": "bash scripts/deploy.sh api",
    "deploy:lp": "bash scripts/deploy.sh lp",
    "deploy:all": "bash scripts/deploy.sh all",
    "deploy:mobile:preview": "cd apps/mobile && eas build --profile preview --platform all",
    "deploy:mobile:prod": "cd apps/mobile && eas build --profile production --platform all"
  },
  "devDependencies": {
    "serve": "^14.2.0"
  },
  "engines": {
    "node": ">=20.0.0",
    "npm": ">=10.0.0"
  }
}
